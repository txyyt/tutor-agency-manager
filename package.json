{
  "name": "tutor-agency-manager",
  "private": true,
  "version": "1.0.0",
  "description": "家教中介内部管理系统（Windows桌面版与本机Web应用）",
  "type": "module",
  "main": "desktop/main.mjs",
  "author": "Tutor Agency Manager",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "dev:desktop": "npm run build && electron .",
    "build:desktop": "npm run build",
    "pack:win": "npm run build:desktop && electron-builder --win --x64 --dir --publish never",
    "dist:win": "npm run build:desktop && electron-builder --win --x64 --publish never",
    "test:desktop": "node --import tsx scripts/test-desktop.mjs",
    "release:check": "node scripts/verify-release.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "cleanup:preview": "tsx scripts/cli.ts cleanup-preview",
    "cleanup": "tsx scripts/cli.ts cleanup",
    "backup": "tsx scripts/cli.ts backup",
    "restore": "tsx scripts/cli.ts restore"
  },
  "dependencies": {
    "express": "5.2.1",
    "jszip": "3.10.2",
    "multer": "2.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "25.9.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  }
}
